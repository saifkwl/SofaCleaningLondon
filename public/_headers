# Response headers for Cloudflare Pages and Netlify.
#
# A static export has no server, so these cannot live in next.config.mjs.
# This file is copied verbatim into the build output and read by the host.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Hashed build assets are safe to cache forever.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Images are content-addressed by filename; bump the filename to bust this.
/images/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

# Let crawlers pick up changes promptly.
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
